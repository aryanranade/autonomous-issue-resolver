# Copy this file to `.env` and fill in ONE key — whichever provider
# config.toml points at. `.env` is gitignored and never committed.
#
#   cp .env.example .env
#
# config.toml's `api_key_env` names which variable is read, so the variable you
# set here must match it. The shipped config uses Groq.

# --- Groq (the default in config.toml) --------------------------------------
# Free key: https://console.groq.com/keys
# config.toml: provider = "groq"
#              base_url = "https://api.groq.com/openai/v1"
GROQ_API_KEY=your_groq_api_key_here

# --- Google Gemini ----------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# config.toml: provider    = "gemini"
#              api_key_env = "GEMINI_API_KEY"
#              base_url    = "https://generativelanguage.googleapis.com/v1beta/openai/"
# GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI, or any other OpenAI-compatible endpoint ------------------------
# Covers OpenAI, OpenRouter, DeepSeek, Together, a local vLLM/Ollama server, ...
# config.toml: provider    = "openai"
#              api_key_env = "OPENAI_API_KEY"
#              base_url    = "https://api.openai.com/v1"   (or your provider's)
# OPENAI_API_KEY=your_openai_api_key_here
